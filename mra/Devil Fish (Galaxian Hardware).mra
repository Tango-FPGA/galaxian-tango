<misterromdescription>
	<name>Devil Fish</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version>Galaxian Hardware</version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1984</year>
	<manufacturer>Vision</manufacturer>
	<manufacturer2>Artic</manufacturer2>
	<category>Maze</category>

	<setname>devilfsg</setname>
	<parent>devilfish</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Devil Fish (Galaxian Hardware).mra" (the MiSTer arcade
	     package's _Arcade folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte,
	     rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer
	     has one. <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS devilfshg (GAME line 16407, set devilfshg):
	     the menu has Coin A (bit 14), Coin B (bit 15), Bonus Life (bit 16), Lives (bit 18), Cabinet (bit 19) with
	     MAME's settings and defaults. Changed or removed from MiSTer's file: Coinage (bit 14: 2c/1cr,1c/1cr); Bonus
	     Life After (bit 16: 10000,15000); Difficulty (bit 17: Easy,Hard). The default is FF,FF,00 (MiSTer's file:
	     FF,5F,00). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service); Service is "-", not
	     read by this game, and sets no default layout (the buttons are defined in the menu). No ROM data from a MAME
	     zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (ccw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>4-way</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="FF,FF,00">
		<dip bits="14" ids="2 Coins/1 Credit,1 Coin/1 Credit" name="Coin A"></dip>
		<dip bits="15" ids="1 Coin/3 Credits,1 Coin/5 Credits" name="Coin B" values="1,0"></dip>
		<dip bits="16" ids="10000,15000" name="Bonus Life"></dip>
		<dip bits="18" ids="4,5" name="Lives"></dip>
		<dip bits="19" ids="Upright,Cocktail" name="Cabinet"></dip>
	</switches>

	<rom index="1">
		<part>06</part>
	</rom>
	<rom index="0" md5="3af9bea33dc72c07afb13e17e588289d" zip="devilfsh.zip|devilfsg.zip">
		<part crc="2ab19698" name="dfish1.7f"></part>
		<part crc="4e77f097" name="dfish2.7h"></part>
		<part crc="3f16a4c6" name="dfish3.7k"></part>
		<part crc="11fc7e59" name="dfish4.7m"></part>
		<part crc="ace6e31f" name="dfish5.1h"></part>
		<part crc="d7a6c4c4" name="dfish6.1k"></part>
		<part crc="4e3caeab" name="82s123.6e"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3" md5="none">
		<part>
		00 00 FF FF 00 FF 00 02 00 02 00 01 00 FF 02 00
		00 00 40 a8 00 03 00 00
		</part>
	</rom>
	<nvram index="4" size="3"/>

	<remark></remark>

	<mratimestamp>20210430005030</mratimestamp>
</misterromdescription>

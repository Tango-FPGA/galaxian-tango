<misterromdescription>
	<name>Victory</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1982</year>
	<manufacturer>Bootleg</manufacturer>
	<category>Shooter - Multidirectional</category>

	<setname>victorycb</setname>
	<parent>victoryc</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Victory.mra" (the MiSTer arcade package's _Arcade
	     folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte, rom index 0 the
	     image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer has one.
	     <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS victoryc (GAME line 16348, set victorycb): the menu has
	     Coinage (bit 14), Lives (bit 18), Cabinet (bit 19) with MAME's settings and defaults. Off the menu at MAME's
	     default: Unknown (bit 15), Unknown (bit 16), Unknown (bit 17). Changed or removed from MiSTer's file: Coinage
	     (bit 14: 2c/1cr,1c/1cr); Lives (bit 18: 2,3). The default is FF,DF,07 (MiSTer's file: FF,FF,F7). <buttons>
	     names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service); Service is "-", not read by this game, and
	     sets no default layout (the buttons are defined in the menu). No ROM data from a MAME zip is in this file: the
	     ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (ccw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="FF,DF,07">
		<dip bits="14" ids="A: 2C/1C B: 1C/3C,A: 1C/1C B: 1C/6C" name="Coinage"></dip>
		<dip bits="18" ids="2,3" name="Lives" values="1,0"></dip>
		<dip bits="19" ids="Upright,Cocktail" name="Cabinet"></dip>
	</switches>

	<rom index="1">
		<part>0D</part>
	</rom>
	<rom index="0" md5="86deedc5164beb2252765df36e5a9ed6" zip="victoryc.zip|victorycb.zip">

		<part crc="a206757d" name="chg2.1k"></part>
		<part crc="a206757d" name="chg2.1k"></part>
		<part crc="9cd550e7" name="chg1.1h"></part>
		<part crc="9cd550e7" name="chg1.1h"></part>
		<part crc="15dd5b16" name="kb2-1"></part>
		<part repeat="0x0FE0">00</part>
		<part crc="5be2c80a" name="kbe1.ic4"/>
		<part crc="bb59e965" name="kbe2.ic5"/>
		<part crc="fbc7d286" name="kbe3.ic6"/>
		<part crc="bb59e965" name="kbe2.ic7"/>
	</rom>
	<rom index="2"></rom>
	<rom index="3" md5="none">

<misterromdescription>
	<name>King &amp; Balloon</name>
	<region>USA</region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1980</year>
	<manufacturer>Namco</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>kingball</setname>
	<parent>kingball</parent>
	<mameversion>0216</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "King and Balloon (US).mra" (the MiSTer arcade package's
	     _Arcade folder). The <rom> entries and <nvram> are MiSTer's, but for the change below: rom index 1 is the game
	     byte, rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where
	     MiSTer has one. Rom index 3 starts with START_WAIT 0B000000 (MiSTer's file: 00000000): this core counts it in
	     its 24.576 MHz clock, and the hi-score table holds the game's own values only from frame 419 after reset, so a
	     hi-score save before then is refused. <name> is MAME's title, "King & Balloon" (MiSTer's file said "King and
	     Balloon"). <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS kingball (GAME line 16528, set kingball):
	     the menu has Cabinet (bit 5), Service Mode (bit 6), Coinage (bits 14,15), Bonus Life (bits 16,17), Lives (bit
	     18), Speech (bit 24) with MAME's settings and defaults. Off the menu at MAME's default: Unused (bit 19).
	     Changed or removed from MiSTer's file: Service (bit 7: Off,On); Test (bit 6: Off,On); Coinage (bits 14,15:
	     1c/1cr,1c/2cr,2c/1cr,Free Play); Bonus Life After (bits 16,17: 10000,12000,15000,None). The default is
	     9F,5F,04,01 (MiSTer's file: 1F,1F,04). Speech (bit 24, DIP byte 3 bit 0) is the speech board's enable switch,
	     MAME's FAKE port bit 1; Service Mode (bit 6) is FAKE bit 0, read on IN0 bit 6 while 9N Q3 is 0. <buttons> names
	     the core's buttons (Fire, Start 1P, Start 2P, Coin, Service), and sets no default layout (the buttons are
	     defined in the menu). No ROM data from a MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,Service"></buttons>

	<switches default="9F,5F,04,01">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="6" ids="Off,On" name="Service Mode"></dip>
		<dip bits="14,15" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" name="Coinage" values="3,1,2,0"></dip>
		<dip bits="16,17" ids="10000,12000,15000,None" name="Bonus Life"></dip>
		<dip bits="18" ids="2,3" name="Lives"></dip>
		<dip bits="24" ids="Off,On" name="Speech"></dip>
	</switches>

	<rom index="1"><part>07</part></rom>
	<rom index="0" md5="55616b75842d0982e3cf14a127fb328a" type="merged|nonmerged" zip="kingball.zip">

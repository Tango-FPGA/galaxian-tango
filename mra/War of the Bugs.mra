<misterromdescription>
	<name>War of the Bugs or Monsterous Manouvers in a Mushroom Maze</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1981</year>
	<manufacturer>Armenia</manufacturer>
	<manufacturer2>Food and Fun Corp</manufacturer2>
	<category>Shooter - Gallery</category>

	<setname>warofbug</setname>
	<parent>warofbug</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "War of the Bugs.mra" (the MiSTer arcade package's
	     _Arcade folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte, rom index
	     0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer has one.
	     <name> is MAME's title, "War of the Bugs or Monsterous Manouvers in a Mushroom Maze" (MiSTer's file said "War
	     of the Bugs"). <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS warofbug (GAME line 16351, set
	     warofbug): the menu has Cabinet (bit 5), Coinage (bits 14,15), Lives (bits 16,17), Bonus Life (bit 19) with
	     MAME's settings and defaults. Off the menu at MAME's default: Unused (bit 18). Changed or removed from MiSTer's
	     file: Coinage (bits 14,15: 1c/1cr,2c/1cr,Free Play); Bonus Life After (bit 19: 50k,75k). The default is
	     DF,3F,0A (MiSTer's file: DF,3F,F2). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin,
	     Service); Service is "-", not read by this game, and sets no default layout (the buttons are defined in the
	     menu). No ROM data from a MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="DF,3F,0A">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="14,15" ids="2 Coins/1 Credit,1 Coin/1 Credit,Free Play" name="Coinage" values="1,0,3"></dip>
		<dip bits="16,17" ids="1,2,3,4" name="Lives"></dip>
		<dip bits="19" ids="500000,750000" name="Bonus Life" values="1,0"></dip>
	</switches>

	<rom index="1">
		<part>0E</part>
	</rom>
	<rom index="0" md5="8144c0785b188d739f3abebc761f4bb8" zip="warofbug.zip">
		<part crc="b8dfb7e3" name="warofbug.u"></part>
		<part crc="fd8854e0" name="warofbug.v"></part>
		<part crc="4495aa14" name="warofbug.w"></part>
		<part crc="c14a541f" name="warofbug.y"></part>
		<part crc="c167fe55" name="warofbug.z"></part>
		<part crc="c167fe55" name="warofbug.z"></part>
		<part crc="c167fe55" name="warofbug.z"></part>
		<part crc="c167fe55" name="warofbug.z"></part>
		<part crc="8100fa85" name="warofbug.1k"></part>
		<part crc="8100fa85" name="warofbug.1k"></part>
		<part crc="d1220ae9" name="warofbug.1j"></part>
		<part crc="d1220ae9" name="warofbug.1j"></part>
		<part crc="8688e64b" name="warofbug.clr"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3"></rom>
	<rom index="4"></rom>

	<nvram></nvram>


<misterromdescription>
	<name>Moon Quasar</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version>Galaxian Hardware</version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1980</year>
	<manufacturer>Nichibutsu</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>moonqsr</setname>
	<parent>moonqsr</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Moon Quasar.mra" (the MiSTer arcade package's _Arcade
	     folder). The <rom> entries and <nvram> are MiSTer's, but for the change below: rom index 1 is the game byte,
	     rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer
	     has one. Rom index 0 lists mqb, mqd before mqa, mqc (MiSTer's file has mqa, mqc first): the image's 0x4000
	     plane is then the one the core shows as VID bit 1, as MAME draws it. MiSTer's md5 is none, so no md5 changes.
	     <rotation> is MAME's, vertical (cw) (ROT90; MiSTer's file said vertical (ccw)). <switches> follow MAME 0.264's
	     galaxian.cpp INPUT_PORTS moonqsr (GAME line 16471, set moonqsr): the menu has Cabinet (bit 5), Difficulty (bits
	     14,15), Coin A (bits 16,17), Coin B (bits 18,19) with MAME's settings and defaults. Changed or removed from
	     MiSTer's file: Coinage (bits 16,17: 1C/1C,2C/1C,3C/1C,4C/1C). The default is 1F,1F,00 (MiSTer's file:
	     DF,7F,04). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service); Service is "-", not
	     read by this game, and sets no default layout (the buttons are defined in the menu). No ROM data from a MAME
	     zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="1F,1F,00">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="14,15" ids="Easy,Medium,Hard,Hardest" name="Difficulty"></dip>
		<dip bits="16,17" ids="4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit" name="Coin A" values="3,2,1,0"></dip>
		<dip bits="18,19" ids="1 Coin/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,Free Play" name="Coin B"></dip>
	</switches>

	<rom index="1">
		<part>0F</part>
	</rom>
	<rom index="0" md5="none" zip="moonqsr.zip">
		<part crc="132c13ec" name="mq1"></part>
		<part crc="c8eb74f1" name="mq2"></part>
		<part crc="33965a89" name="mq3"></part>
		<part crc="a3861d17" name="mq4"></part>
		<part crc="8bcf9c67" name="mq5"></part>
		<part crc="5750cda9" name="mq6"></part>
		<part crc="78d7fe5b" name="mq7"></part>
		<part crc="4919eed5" name="mq8"></part>
		<part crc="b55ec806" name="mqb"></part>
		<part crc="9e7d0e13" name="mqd"></part>
		<part crc="66eee0db" name="mqa"></part>
		<part crc="a6db5b0d" name="mqc"></part>
		<part crc="0b878b54" name="vid_e6.bin"></part>
	</rom>

	<mratimestamp>20210430005030</mratimestamp>
</misterromdescription>

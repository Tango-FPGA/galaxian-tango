<misterromdescription>
	<name>Catacomb</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1982</year>
	<manufacturer>MTM Games</manufacturer>
	<category>Shooter - Vertical</category>

	<setname>catacomb</setname>
	<parent>catacomb</parent>
	<mameversion>0217</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Catacomb.mra" (the MiSTer arcade package's _Arcade
	     folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte, rom index 0 the
	     image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer has one.
	     <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS catacomb (GAME line 16337, set catacomb): the menu has
	     Cabinet (bit 5), Coin A (bit 14), Coin B (bit 15), Lives (bit 18) with MAME's settings and defaults. Off the
	     menu at MAME's default: Unknown (bit 6), Unknown (bit 7), Unknown (bit 13), Unknown (bit 16), Unknown (bit 17),
	     Unknown (bit 19). Changed or removed from MiSTer's file: Coinage (bit 14: 2c/1cr,1c/1cr); Lives (bit 18: 5,3).
	     The default is 1F,5F,04 (MiSTer's file: FF,DF,04). <buttons> names the core's buttons (Fire, Start 1P, Start
	     2P, Coin, Service); Service is "-", not read by this game, and sets no default layout (the buttons are defined
	     in the menu). No ROM data from a MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="1F,5F,04">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="14" ids="2 Coins/1 Credit,1 Coin/1 Credit" name="Coin A"></dip>
		<dip bits="15" ids="1 Coin/3 Credits,1 Coin/5 Credits" name="Coin B"></dip>
		<dip bits="18" ids="3,5" name="Lives" values="1,0"></dip>
	</switches>

	<rom index="1">
		<part>04</part>
	</rom>
	<rom index="0" md5="a9c00095b4ccb5183445aa9e67c873af" zip="catacomb.zip">
		<part crc="35cc28d2" name="catacomb.u"></part>
		<part crc="1d1ce133" name="catacomb.v"></part>
		<part crc="479bbde7" name="catacomb.w"></part>
		<part crc="479bbde7" name="catacomb.w"></part>
		<part crc="5e3da534" name="catacomb.y"></part>
		<part crc="5e3da534" name="catacomb.y"></part>
		<part crc="5e3da534" name="catacomb.y"></part>
		<part crc="5e3da534" name="catacomb.y"></part>
		<part crc="e871e65c" name="cat-gfx1"></part>
		<part crc="e871e65c" name="cat-gfx1"></part>
		<part crc="b14dafaa" name="cat-gfx2"></part>
		<part crc="b14dafaa" name="cat-gfx2"></part>
		<part crc="6a0c7d87" name="mmi6331.6l"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3"></rom>
	<rom index="4"></rom>


<misterromdescription>
	<name>Omega</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>yes</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1981</year>
	<manufacturer>Nihon</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>omegab</setname>
	<parent>theend</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Omega [bl].mra" (the MiSTer arcade package's _Arcade
	     folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte, rom index 0 the
	     image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer has one.
	     <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS omegab (GAME line 16338, set omegab): the menu has Coin
	     A (bit 14), Coin B (bit 15), Bonus Life (bit 16), Lives (bit 18), Cabinet (bit 19) with MAME's settings and
	     defaults. Off the menu at MAME's default: Unused (bit 17). Changed or removed from MiSTer's file: Coinage (bit
	     14: 2c/1cr,1c/1cr); Bonus Life After (bit 16: 10000,20000). The default is 1F,DF,00 (MiSTer's file: FF,5F,00).
	     <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service); Service is "-", not read by this
	     game, and sets no default layout (the buttons are defined in the menu). No ROM data from a MAME zip is in this
	     file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (ccw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="1F,DF,00">
		<dip bits="14" ids="2 Coins/1 Credit,1 Coin/1 Credit" name="Coin A"></dip>
		<dip bits="15" ids="1 Coin/3 Credits,1 Coin/5 Credits" name="Coin B" values="1,0"></dip>
		<dip bits="16" ids="10000,20000" name="Bonus Life"></dip>
		<dip bits="18" ids="3,5" name="Lives"></dip>
		<dip bits="19" ids="Upright,Cocktail" name="Cabinet"></dip>
	</switches>

	<rom index="1">
		<part>09</part>
	</rom>
	<rom index="0" md5="3ac6f3a37b980d0cd669c68379c41db0" zip="theend.zip|omegab.zip">
		<part crc="fc2a096b" name="omega1.bin"></part>
		<part crc="ad100357" name="omega2.bin"></part>
		<part crc="d7e3be79" name="omega3.bin"></part>
		<part crc="42068171" name="omega4.bin"></part>
		<part crc="d8a93383" name="omega5.bin"></part>
		<part crc="32a42f44" name="omega6.bin"></part>
		<part crc="32a42f44" name="omega6.bin"></part>
		<part crc="32a42f44" name="omega6.bin"></part>
		<part crc="527fd384" name="omega1h.bin"></part>
		<part crc="527fd384" name="omega1h.bin"></part>
		<part crc="36de42c6" name="omega1k.bin"></part>
		<part crc="36de42c6" name="omega1k.bin"></part>
		<part crc="6a0c7d87" name="mmi6331-1j.86"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3"></rom>
	<rom index="4"></rom>

	<nvram></nvram>

	<remark></remark>

	<mratimestamp>20210430005030</mratimestamp>
</misterromdescription>

<misterromdescription>
	<name>Azurian Attack</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1982</year>
	<manufacturer>Rait Electronics Ltd</manufacturer>
	<category>Shooter - Multidirectional</category>

	<setname>azurian</setname>
	<parent>azurian</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Azurian Attack.mra" (the MiSTer arcade package's _Arcade
	     folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte, rom index 0 the
	     image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer has one.
	     <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS azurian (GAME line 16365, set azurian): the menu has
	     Lives (bit 15), Coinage (bit 16), Bonus Life (bit 17), Cabinet (bit 19) with MAME's settings and defaults. Off
	     the menu at MAME's default: Difficulty (bits 14,18), bits not adjacent. Changed or removed from MiSTer's file:
	     Coin (bit 16: 1c/1cr,2c/1cr); Bonus Life After (bit 17: 5000,7000). The default is 7F,7F,00 (MiSTer's file:
	     7F,1F,04). Difficulty is MAME's FAKE port, read as IN1 bit 6 (bit 14) and IN2 bit 2 (bit 18); the two bits are
	     not adjacent, so it has no menu entry and is set to MAME's default, Normal. <buttons> names the core's buttons
	     (Fire, Start 1P, Start 2P, Coin, Service); Service is "-", not read by this game, and sets no default layout
	     (the buttons are defined in the menu). No ROM data from a MAME zip is in this file: the ROMs come from your own
	     MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<special_controls></special_controls>
	<num_buttons>2</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="7F,7F,00">
		<dip bits="15" ids="3,5" name="Lives"></dip>
		<dip bits="16" ids="2 Coins/1 Credit,1 Coin/1 Credit" name="Coinage" values="1,0"></dip>
		<dip bits="17" ids="5000,7000" name="Bonus Life"></dip>
		<dip bits="19" ids="Upright,Cocktail" name="Cabinet"></dip>
	</switches>

	<rom index="1">
		<part>02</part>
	</rom>
	<rom index="0" md5="ac001e48386008c63a602fe73c7121ba" zip="azurian.zip">
		<part crc="17a0fca7" name="pgm.1"></part>
		<part crc="14659848" name="pgm.2"></part>
		<part crc="8f60fb97" name="pgm.3"></part>
		<part crc="8f60fb97" name="pgm.3"></part>
		<part crc="f5afb803" name="gfx.1"></part>
		<part crc="f5afb803" name="gfx.1"></part>
		<part crc="ae96e5d1" name="gfx.2"></part>
		<part crc="ae96e5d1" name="gfx.2"></part>
		<part crc="6a0c7d87" name="l06_prom.bin"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3" md5="none">
		<part>
		00 FF FF FF 00 FF 00 02 00 02 00 01 00 FF 02 00
		00 00 40 B3 00 03 00 00
		00 00 40 B4 00 01 50 50
		</part>
	</rom>
	<nvram index="4" size="4"/>

	<remark></remark>

	<mratimestamp>20210430005030</mratimestamp>
</misterromdescription>

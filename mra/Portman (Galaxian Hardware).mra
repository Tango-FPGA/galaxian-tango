<misterromdescription>
	<name>Port Man</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1980</year>
	<manufacturer>Irem</manufacturer>
	<category>Dunno</category>

	<setname>Portman</setname>
	<parent>Portman</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Portman (Galaxian Hardware).mra" (the MiSTer arcade
	     package's _Arcade folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte,
	     rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer
	     has one. <name> is MAME's title, "Port Man" (MiSTer's file said "Portman"). <switches> follow MAME 0.264's
	     galaxian.cpp INPUT_PORTS porter (GAME line 16496, set porter): the menu has Bonus Life (bit 14), Cabinet (bit
	     15), Coinage (bit 16), Lives (bits 18,19) with MAME's settings and defaults. Off the menu at MAME's default:
	     Unused (bit 17). Changed or removed from MiSTer's file: Bonus Life After (bit 14: 10000,30000); Coinage (bit
	     16: 2c/1cr,1c/1cr). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service); Service is
	     "-", not read by this game, and sets no default layout (the buttons are defined in the menu). No ROM data from
	     a MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="FF,3F,07">
		<dip bits="14" ids="10000 only,30000 only" name="Bonus Life"></dip>
		<dip bits="15" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="16" ids="A 2C/1C  B 1C/3C,A 1C/1C  B 1C/6C" name="Coinage"></dip>
		<dip bits="18,19" ids="2,3,4,5" name="Lives"></dip>
	</switches>

	<rom index="1">
		<part>05</part>
	</rom>

	<rom index="0" md5="none" zip="porter.zip|dockman.zip">
		<part crc="babaf7fe" name="port1.bin"></part>
		<part crc="8f7eb0e3" name="port2.bin"></part>
		<part crc="683939b5" name="port3.bin"></part>
		<part crc="6a65d58d" name="port4.bin"></part>
		<part crc="2978a9aa" name="port5.bin"></part>
		<part crc="7ecdffb5" name="port6.bin"></part>
		<part crc="603294f9" name="port7.bin"></part>
		<part crc="b66a763d" name="port8.bin"></part>
		<part crc="6a0c7d87" name="mmi6331.6l"></part>
	</rom>
	<rom index="3" md5="none">
	</rom>
	<nvram index="4" size="3"/>

	<remark></remark>

	<mratimestamp>20210430005030</mratimestamp>
</misterromdescription>

	<setname>piscesb</setname>
	<parent>pisces</parent>
	<mameversion>0218</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "_alternatives/_Pisces/Pisces (bootleg).mra" (the MiSTer
	     arcade package's _Arcade folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the
	     game byte, rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table
	     where MiSTer has one. <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS piscesb (GAME line 16369, set
	     piscesb): the menu has Lives (bit 14), Cabinet (bit 15), Bonus Life (bit 16), Coinage (bit 17), Difficulty (bit
	     18) with MAME's settings and defaults. Off the menu at MAME's default: Unused (bit 19). Changed or removed from
	     MiSTer's file: Bonus Life After (bit 16: 10000,20000); Coinage (bit 17: 1c/1cr,2c/1cr). The default is 1F,1F,00
	     (MiSTer's file: FF,1F,00). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service);
	     Service is "-", not read by this game, and sets no default layout (the buttons are defined in the menu). No ROM
	     data from a MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="1F,1F,00">
		<dip bits="14" ids="3,4" name="Lives"></dip>
		<dip bits="15" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="16" ids="10000,20000" name="Bonus Life"></dip>
		<dip bits="17" ids="A 2C/1C  B 1C/2C 2C/5C,A 1C/1C  B 1C/5C" name="Coinage" values="1,0"></dip>
		<dip bits="18" ids="Easy,Hard" name="Difficulty"></dip>
	</switches>

	<rom index="1">
		<part>0B</part>
		</rom>
	<rom index="0" md5="cb6521abfe0cc628aedce40635cf85f1" zip="pisces.zip|piscesb.zip">

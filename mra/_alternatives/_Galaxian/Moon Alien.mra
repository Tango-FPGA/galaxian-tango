		<part crc="8bb78987" name="prg5.bin"></part>
		<part crc="8bb78987" name="prg5.bin"></part>
		<part crc="074271dd" name="ca1.bin"></part>
		<part crc="074271dd" name="ca1.bin"></part>
		<part crc="84d90397" name="ca2.bin"></part>
		<part crc="84d90397" name="ca2.bin"></part>
		<part crc="c3ac9467" name="6l.bpr"></part>
		</rom>
	<rom index="2"></rom>
	<rom index="3"></rom>

		<part crc="a433067e" name="princip2.v"></part>
		<part crc="aaf038d4" name="princip3.w"></part>
		<part crc="d74bdd2a" name="princip4.y"></part>
		<part crc="7eeb9e63" name="princip5.z"></part>
		<part crc="7eeb9e63" name="princip5.z"></part>
		<part crc="7eeb9e63" name="princip5.z"></part>
		<part crc="7eeb9e63" name="princip5.z"></part>
		<part crc="39fb43a4" name="graphhj.j1"></part>
		<part crc="39fb43a4" name="graphhj.j1"></part>
		<part crc="7e3f56a2" name="graphkl.l1"></part>
		<part crc="7e3f56a2" name="graphkl.l1"></part>
		<part crc="c3ac9467" name="6l.bpr"></part>
		</rom>
	<rom index="2"></rom>

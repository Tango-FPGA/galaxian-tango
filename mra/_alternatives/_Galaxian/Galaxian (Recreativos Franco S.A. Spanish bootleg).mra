<misterromdescription>
	<name>Galaxian</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>yes</bootleg>
	<version>Spanish</version>
	<alternative>Galaxian</alternative>
	<platform></platform>
	<series>Galaxian</series>
	<year>1979</year>
	<manufacturer>Namco</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>galaxrf</setname>
	<parent>galaxian</parent>
	<mameversion>0218</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "_alternatives/_Galaxian/Galaxian (Recreativos Franco
	     S.A. Spanish bootleg).mra" (the MiSTer arcade package's _Arcade folder). The <rom> entries and <nvram> are
	     MiSTer's, unchanged: rom index 1 is the game byte, rom index 0 the image in upstream's layout (its md5 is
	     MiSTer's), rom index 3 the hi-score table where MiSTer has one. <switches> follow MAME 0.264's galaxian.cpp
	     INPUT_PORTS galaxrf (GAME line 16307, set galaxrf): the menu has Cabinet (bit 5), Service Mode (bit 6), Coinage
	     (bits 14,15), Bonus Life / Enemy Bullet Speed (bits 16,17), Lives (bit 18), Player Bullet Speed (bit 19) with
	     MAME's settings and defaults. Changed or removed from MiSTer's file: Service (bit 7: Off,On); Test (bit 6:
	     Off,On); Coinage (bits 14,15: 1c/1cr,1c/2cr,2c/1cr,Free Play); Bonus Life After (bits 16,17:
	     7000,10000,12000,20000). The default is 9F,1F,01 (MiSTer's file: 1F,1F,04). <buttons> names the core's buttons
	     (Fire, Start 1P, Start 2P, Coin, Service), and sets no default layout (the buttons are defined in the menu).
	     The empty rom index 1 leaves the core on its default game byte, 00 (Galaxian). No ROM data from a MAME zip is
	     in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,Service"></buttons>

	<switches default="9F,1F,01">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="6" ids="Off,On" name="Service Mode"></dip>
		<dip bits="14,15" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" name="Coinage" values="1,0,2,3"></dip>
		<dip bits="16,17" ids="None / Slow,12000 / Medium,20000 / Fast,30000 / Fastest" name="Bonus Life / Enemy Bullet Speed"></dip>
		<dip bits="18" ids="2,3" name="Lives"></dip>
		<dip bits="19" ids="Slow,Fast" name="Player Bullet Speed"></dip>
	</switches>

	<rom index="1"></rom>
	<rom index="0" md5="88645ba127aad3bf4910303d260b3fe7" zip="galaxian.zip|galaxrf.zip">

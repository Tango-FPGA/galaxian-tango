<misterromdescription>
	<name>Kamakazi III</name>
	<region></region>
	<homebrew>yes</homebrew>
	<bootleg>no</bootleg>
	<version>Superg</version>
	<alternative>Scramble</alternative>
	<platform></platform>
	<series></series>

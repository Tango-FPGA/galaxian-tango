<misterromdescription>
	<name>Space Empire</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>yes</bootleg>
	<version></version>
	<alternative>UniWar S</alternative>
	<platform></platform>
	<series></series>
	<year>1980</year>
	<manufacturer>bootleg</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>spacempr</setname>
	<parent></parent>
	<mameversion>0218</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "_alternatives/_Uniwars/Space Empire (bootleg).mra" (the
	     MiSTer arcade package's _Arcade folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is
	     the game byte, rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table
	     where MiSTer has one. <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS spacempr (GAME line 16381, set
	     spacempr): the menu has Cabinet (bit 5), Service Mode (bit 6), Lives (bit 13), Bonus Life (bits 14,15), Coin A
	     (bits 16,17), Coin B (bits 18,19) with MAME's settings and defaults. Changed or removed from MiSTer's file:
	     Service (bit 7: Off,On); Test (bit 6: Off,On); Coinage (bits 14,15: 1c/1cr,1c/2cr,2c/1cr,Free Play); Bonus Life
	     After (bits 16,17: None,4000,5000,7000); Lives (bit 18: 3,5). The default is 9F,5F,00 (MiSTer's file:
	     1F,1F,00). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service), and sets no default
	     layout (the buttons are defined in the menu). No ROM data from a MAME zip is in this file: the ROMs come from
	     your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,Service"></buttons>

	<switches default="9F,5F,00">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="6" ids="Off,On" name="Service Mode"></dip>
		<dip bits="13" ids="3,5" name="Lives"></dip>
		<dip bits="14,15" ids="None,4000,5000,7000" name="Bonus Life"></dip>
		<dip bits="16,17" ids="1 Coin/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,1 Coin/6 Credits" name="Coin A"></dip>
		<dip bits="18,19" ids="1 Coin/1 Credit,2 Coins/1 Credit,3 Coins/1 Credit,Free Play" name="Coin B"></dip>
	</switches>

	<rom index="1">
		<part>0C</part>
		</rom>
	<rom index="0" md5="adfa077bb690bcd67ce3b18ca4fb6199" zip="uniwars.zip|spacempr.zip">
		<part crc="7c64fb92" name="uw01"></part>
		<part crc="b2ed14c3" name="uw02"></part>
		<part crc="945f4160" name="uw03"></part>
		<part crc="84885060" name="uw04"></part>
		<part crc="e342371d" name="uw05"></part>
		<part crc="d915a389" name="uw06"></part>
		<part crc="c9245346" name="uw07"></part>
		<part crc="a237c394" name="uw08"></part>
		<part crc="af069cba" name="uw10"></part>
		<part crc="c26132af" name="uw12"></part>
		<part crc="ff2c20d5" name="uw09"></part>
		<part crc="dcc2b33b" name="uw11"></part>
		<part crc="6a0c7d87" name="mmi6331"></part>
		</rom>
	<rom index="2"></rom>
	<rom index="3"></rom>
	<rom index="4"></rom>

	<nvram></nvram>


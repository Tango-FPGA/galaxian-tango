		<part crc="c26132af" name="h01_2.bin"></part>
		<part crc="c9d4537e" name="k01_1.bin"></part>
		<part crc="dcc2b33b" name="k01_2.bin"></part>
		<part crc="6a0c7d87" name="l06_prom.bin"></part>
		</rom>
	<rom index="2"></rom>

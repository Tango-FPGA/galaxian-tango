<misterromdescription>
	<name>Pajaro del Espacio</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>yes</bootleg>
	<version>UniWar S, Spanish</version>
	<alternative>UniWar S</alternative>
	<platform></platform>
	<series></series>
	<year>1980</year>
	<manufacturer>PSV S.A.</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>pajaroes</setname>
	<parent>uniwars</parent>
	<mameversion>0218</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "_alternatives/_Uniwars/Pajaro del Espacio (Spanish
	     bootleg of UniWar S).mra" (the MiSTer arcade package's _Arcade folder). The <rom> entries and <nvram> are
	     MiSTer's, unchanged: rom index 1 is the game byte, rom index 0 the image in upstream's layout (its md5 is
	     MiSTer's), rom index 3 the hi-score table where MiSTer has one. <switches> follow MAME 0.264's galaxian.cpp
	     INPUT_PORTS asideral (GAME line 16385, set pajaroes): the menu has Cabinet (bit 5), Service Mode (bit 6),
	     Coinage (bits 14,15), Bonus Life (bits 16,17), Lives (bit 18) with MAME's settings and defaults. Off the menu
	     at MAME's default: Unused (bit 19). Changed or removed from MiSTer's file: Service (bit 7: Off,On); Test (bit
	     6: Off,On); Coinage (bits 14,15: 1c/1cr,1c/2cr,2c/1cr,Free Play); Bonus Life After (bits 16,17:
	     None,4000,5000,7000). The default is 9F,5F,01 (MiSTer's file: 1F,1F,00). <buttons> names the core's buttons
	     (Fire, Start 1P, Start 2P, Coin, Service), and sets no default layout (the buttons are defined in the menu). No
	     ROM data from a MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,Service"></buttons>

	<switches default="9F,5F,01">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="6" ids="Off,On" name="Service Mode"></dip>
		<dip bits="14,15" ids="1 Coin/1 Credit,1C/2C / 1C/1C,1C/4C / 1C/2C,Free Play (corrupt text)" name="Coinage" values="1,0,2,3"></dip>
		<dip bits="16,17" ids="None,4000,5000,7000" name="Bonus Life"></dip>
		<dip bits="18" ids="3,5" name="Lives"></dip>
	</switches>

	<rom index="1">
		<part>0C</part>
		</rom>
	<rom index="0" md5="412f91f40dd34c8ed4686002c734818b" zip="uniwars.zip|pajaroes.zip">
		<part crc="82a9da91" name="pea.rom"></part>
		<part crc="cc59b49c" name="peb.rom"></part>
		<part crc="3bc5a165" name="pec.rom"></part>
		<part crc="c50149d0" name="ped.rom"></part>
		<part crc="cb461871" name="pe05.rom"></part>
		<part crc="f157a8db" name="pe04.rom"></part>
		<part crc="75085cb6" name="pe03.rom"></part>
		<part crc="797d45c7" name="pe02.rom"></part>
		<part crc="012941e0" name="pe07.rom"></part>
		<part crc="c26132af" name="pe09.rom"></part>
		<part crc="fc8b58fd" name="pe06.rom"></part>
		<part crc="dcc2b33b" name="pe08.rom"></part>
		<part crc="25c79518" name="uniwars.clr"></part>
		</rom>
	<rom index="2"></rom>
	<rom index="3"></rom>
	<rom index="4"></rom>

	<nvram></nvram>

	<remark></remark>

	<mratimestamp>20210430005030</mratimestamp>
</misterromdescription>
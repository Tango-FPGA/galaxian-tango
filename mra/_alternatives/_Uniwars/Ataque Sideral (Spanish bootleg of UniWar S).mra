<misterromdescription>
	<name>Ataque Sideral</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>yes</bootleg>
	<version>Spanish, UniWar S</version>
	<alternative>UniWar S</alternative>
	<platform></platform>
	<series></series>
	<year>1980</year>
	<manufacturer>Electrogame S.A.</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>asideral</setname>
	<parent>uniwars</parent>
	<mameversion>0218</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "_alternatives/_Uniwars/Ataque Sideral (Spanish bootleg
	     of UniWar S).mra" (the MiSTer arcade package's _Arcade folder). The <rom> entries and <nvram> are MiSTer's,
	     unchanged: rom index 1 is the game byte, rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom
	     index 3 the hi-score table where MiSTer has one. <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS
	     asideral (GAME line 16384, set asideral): the menu has Cabinet (bit 5), Service Mode (bit 6), Coinage (bits
	     14,15), Bonus Life (bits 16,17), Lives (bit 18) with MAME's settings and defaults. Off the menu at MAME's
	     default: Unused (bit 19). Changed or removed from MiSTer's file: Service (bit 7: Off,On); Test (bit 6: Off,On);
	     Coinage (bits 14,15: 1c/1cr,1c/2cr,2c/1cr,Free Play); Bonus Life After (bits 16,17: None,4000,5000,7000). The
	     default is 9F,5F,01 (MiSTer's file: 1F,1F,00). <buttons> names the core's buttons (Fire, Start 1P, Start 2P,
	     Coin, Service), and sets no default layout (the buttons are defined in the menu). No ROM data from a MAME zip
	     is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,Service"></buttons>

	<switches default="9F,5F,01">
		<dip bits="5" ids="Upright,Cocktail" name="Cabinet"></dip>
		<dip bits="6" ids="Off,On" name="Service Mode"></dip>
		<dip bits="14,15" ids="1 Coin/1 Credit,1C/2C / 1C/1C,1C/4C / 1C/2C,Free Play (corrupt text)" name="Coinage" values="1,0,2,3"></dip>
		<dip bits="16,17" ids="None,4000,5000,7000" name="Bonus Life"></dip>
		<dip bits="18" ids="3,5" name="Lives"></dip>
	</switches>

	<rom index="1">
		<part>0C</part>
		</rom>
	<rom index="0" md5="f8637a6f8d1bcb4ed6ee97db15da7b6a" zip="uniwars.zip|asideral.zip">

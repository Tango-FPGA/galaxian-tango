	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "_alternatives/_Uniwars/Gingateikoku no Gyakushu (bootleg
	     set 2).mra" (the MiSTer arcade package's _Arcade folder). The <rom> entries and <nvram> are MiSTer's,
	     unchanged: rom index 1 is the game byte, rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom
	     index 3 the hi-score table where MiSTer has one. <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS
	     gteikokub2 (GAME line 16377, set gteikokub2): the menu has Coin A (bit 14), Coin B (bit 15), Bonus Life (bit
	     16), Lives (bit 18), Cabinet (bit 19) with MAME's settings and defaults. Off the menu at MAME's default: Unused
	     (bit 17). Changed or removed from MiSTer's file: Service (bit 7: Off,On); Test (bit 6: Off,On); Cabinet (bit 5:
	     Upright,Cocktail); Coinage (bits 14,15: 1c/1cr,1c/2cr,2c/1cr,Free Play); Bonus Life After (bits 16,17:
	     None,4000,5000,7000). The default is 1F,DF,08 (MiSTer's file: 1F,1F,00). <buttons> names the core's buttons
	     (Fire, Start 1P, Start 2P, Coin, Service); Service is "-", not read by this game, and sets no default layout
	     (the buttons are defined in the menu). No ROM data from a MAME zip is in this file: the ROMs come from your own
	     MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="1F,DF,08">
		<dip bits="14" ids="2 Coins/1 Credit,1 Coin/1 Credit" name="Coin A"></dip>
		<dip bits="15" ids="1 Coin/3 Credits,1 Coin/5 Credits" name="Coin B" values="1,0"></dip>
		<dip bits="16" ids="7000,None" name="Bonus Life"></dip>
		<dip bits="18" ids="3,5" name="Lives"></dip>
		<dip bits="19" ids="Upright,Cocktail" name="Cabinet" values="1,0"></dip>
	</switches>

	<rom index="1">

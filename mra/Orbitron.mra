<misterromdescription>
	<name>Orbitron</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1982</year>
	<manufacturer>Comsoft</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>orbitron</setname>
	<parent>orbitron</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Orbitron.mra" (the MiSTer arcade package's _Arcade
	     folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the game byte, rom index 0 the
	     image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table where MiSTer has one.
	     <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS orbitron (GAME line 16334, set orbitron): the menu has
	     Coinage (bits 13,14), Lives (bit 18), Cabinet (bit 19) with MAME's settings and defaults. Off the menu at
	     MAME's default: Unused (bit 16), Unused (bit 17). Changed or removed from MiSTer's file: Coinage (bit 14:
	     2c/1cr,1c/1cr); Bonus Life After (bit 16: 10000,20000); Lives (bit 18: 3,5). The default is FF,DF,00 (MiSTer's
	     file: FF,5F,00). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin, Service); Service is "-",
	     not read by this game, and sets no default layout (the buttons are defined in the menu). No ROM data from a
	     MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (ccw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="FF,DF,00">
		<dip bits="13,14" ids="A 2C/1C  B 1C/3C,A 2C/1C  B 1C/3C (duplicate),A 1C/1C  B 1C/6C,A 1C/1C  B 1C/6C (duplicate)" name="Coinage"></dip>
		<dip bits="18" ids="2,3" name="Lives" values="1,0"></dip>
		<dip bits="19" ids="Upright,Cocktail" name="Cabinet"></dip>
	</switches>

	<rom index="1">
		<part>0A</part>
	</rom>
	<rom index="0" md5="e2d3472c93bde5948f2ec6609e5d4ce4" zip="orbitron.zip">
		<part crc="419f9c9b" name="orbitron.3"></part>
		<part crc="44ad56ac" name="orbitron.4"></part>
		<part crc="da3f5168" name="orbitron.1"></part>
		<part crc="a3b813fc" name="orbitron.2"></part>
		<part crc="20cd8bb8" name="orbitron.5"></part>
		<part crc="20cd8bb8" name="orbitron.5"></part>
		<part crc="20cd8bb8" name="orbitron.5"></part>
		<part crc="20cd8bb8" name="orbitron.5"></part>
		<part crc="2c91b83f" name="orbitron.6"></part>
		<part crc="2c91b83f" name="orbitron.6"></part>
		<part crc="46f4cca4" name="orbitron.7"></part>
		<part crc="46f4cca4" name="orbitron.7"></part>
		<part crc="6a0c7d87" name="l06_prom.bin"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3" md5="none">
		<part>
		00 00 FF 00 00 FF 00 02 00 02 00 01 00 FF 02 00
		00 00 40 4A 00 03 00 00
		</part>
	</rom>
	<nvram index="4" size="3"/>

	<remark></remark>

	<mratimestamp>20210430005030</mratimestamp>
</misterromdescription>

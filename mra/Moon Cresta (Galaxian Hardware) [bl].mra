<misterromdescription>
	<name>Moon Cresta</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>yes</bootleg>
	<version>Galaxian Hardware</version>
	<alternative></alternative>
	<platform></platform>
	<series></series>
	<year>1980</year>
	<manufacturer>Bootleg</manufacturer>
	<category>Shooter - Gallery</category>

	<setname>mooncrgx</setname>
	<parent>mooncrst</parent>
	<mameversion>0220</mameversion>
	<rbf>galaxian</rbf>
	<!-- Tango .mra for the galaxian-tango core, from MiSTer's "Moon Cresta (Galaxian Hardware) [bl].mra" (the MiSTer
	     arcade package's _Arcade folder). The <rom> entries and <nvram> are MiSTer's, unchanged: rom index 1 is the
	     game byte, rom index 0 the image in upstream's layout (its md5 is MiSTer's), rom index 3 the hi-score table
	     where MiSTer has one. <switches> follow MAME 0.264's galaxian.cpp INPUT_PORTS mooncrgx (GAME line 16469, set
	     mooncrgx): the menu has Coin A (bit 14), Coin B (bit 15), Bonus Life (bit 16), Cabinet (bit 19) with MAME's
	     settings and defaults. Off the menu at MAME's default: Unused (bit 17), Unused (bit 18). Changed or removed
	     from MiSTer's file: Coinage (bit 14: 2c/1cr,1c/1cr); Bonus Life After (bit 16: 30000,50000). The default is
	     1F,DF,01 (MiSTer's file: 1F,5F,04). <buttons> names the core's buttons (Fire, Start 1P, Start 2P, Coin,
	     Service); Service is "-", not read by this game, and sets no default layout (the buttons are defined in the
	     menu). No ROM data from a MAME zip is in this file: the ROMs come from your own MAME zips. -->
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (ccw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>1</num_buttons>
	<button_names></button_names>

	<buttons names="Fire,Start 1P,Start 2P,Coin,-"></buttons>

	<switches default="1F,DF,01">
		<dip bits="14" ids="2 Coins/1 Credit,1 Coin/1 Credit" name="Coin A"></dip>
		<dip bits="15" ids="1 Coin/3 Credits,1 Coin/5 Credits" name="Coin B" values="1,0"></dip>
		<dip bits="16" ids="30000,50000" name="Bonus Life" values="1,0"></dip>
		<dip bits="19" ids="Upright,Cocktail" name="Cabinet"></dip>
	</switches>

	<rom index="1">
		<part>01</part>
	</rom>
	<rom index="0" md5="abd1d6477749713797d44d6425642e58" zip="mooncrst.zip|mooncrgx.zip">
		<part crc="84cf420b" name="1"></part>
		<part crc="4c2a61a1" name="2"></part>
		<part crc="1962523a" name="3"></part>
		<part crc="75dca896" name="4"></part>
		<part crc="32483039" name="5"></part>
		<part crc="43f2ab89" name="6"></part>
		<part crc="1e9c168c" name="7"></part>
		<part crc="5e09da94" name="8"></part>
		<part crc="528da705" name="1h_1_10.bin"></part>
		<part crc="5a4b17ea" name="12.chr"></part>
		<part crc="70df525c" name="9.chr"></part>
		<part crc="e0edccbd" name="11.chr"></part>
		<part crc="6a0c7d87" name="l06_prom.bin"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3" md5="none">
